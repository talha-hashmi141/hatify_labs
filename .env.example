# ── Contact form email delivery (Resend — https://resend.com) ──────────────
# Copy this file to .env.local (and add the same variables in Vercel →
# Project → Settings → Environment Variables). Until all three are set, the
# contact form clearly tells visitors that online submissions are unavailable.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Inbox(es) that receive enquiries — comma-separated for several
CONTACT_TO_EMAIL=

# Sender on a domain verified in Resend (e.g. hatifylabs.com)
CONTACT_FROM_EMAIL="Hatify Labs Website <website@hatifylabs.com>"
