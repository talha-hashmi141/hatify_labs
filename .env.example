# ── Contact form email delivery (SMTP via Nodemailer) ──────────────────────
# Copy this file to .env.local (and add the same variables to your host's
# environment settings, e.g. Vercel → Settings → Environment Variables).
# Until the required ones are set, the contact form clearly tells visitors
# that online submissions are unavailable.

# SMTP server — Gmail: smtp.gmail.com · Outlook/365: smtp.office365.com
# Zoho: smtp.zoho.com · Hostinger: smtp.hostinger.com · cPanel: mail.yourdomain.com
SMTP_HOST=
# 465 = SSL (default) · 587 = STARTTLS
SMTP_PORT=465
# Mailbox login. Gmail: full address + a 16-char App Password
# (Google Account → Security → 2-Step Verification → App passwords)
SMTP_USER=
SMTP_PASS=

# Inbox(es) that receive enquiries — comma-separated for several
CONTACT_TO_EMAIL=

# Optional sender. Defaults to "Hatify Labs <SMTP_USER>". Most providers
# (Gmail included) only allow SMTP_USER itself or an alias verified on that account.
# CONTACT_FROM_EMAIL="Hatify Labs <hello@hatifylabs.com>"

# Optional: "true" also emails the visitor a short "we got your message" note.
CONTACT_AUTOREPLY=false
